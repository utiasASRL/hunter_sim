<?xml version="1.0"?>
<robot name="hunter_robot3" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Gazebo references -->

<gazebo reference="base_link">
  <mu1 value="0.0"/>
  <mu2 value="0.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
</gazebo>

<gazebo reference="front_left_wheel_link">
  <mu1 value="2.1"/>
  <mu2 value="1.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
  <fdir1 value="1 0 0"/>
</gazebo>

<gazebo reference="front_right_wheel_link">
  <mu1 value="2.1"/>
  <mu2 value="1.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
  <fdir1 value="1 0 0"/>
</gazebo>

<gazebo reference="rear_left_link">
  <mu1 value="2.1"/>
  <mu2 value="1.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
  <fdir1 value="0 0 1"/>
</gazebo>

<gazebo reference="rear_right_link">
  <mu1 value="2.1"/>
  <mu2 value="1.0"/>
  <kp  value="10000000.0" />
  <kd  value="1.0" />
  <fdir1 value="0 0 1"/>
</gazebo>

<gazebo>
    <!-- Ignition Gazebo Ackermann Steering Plugin -->
    <plugin filename="libignition-gazebo-ackermann-steering-system.so" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>
      <left_steering_joint>front_steer_left_joint</left_steering_joint>
      <right_steering_joint>front_steer_right_joint</right_steering_joint>
      <kingpin_width>0.605</kingpin_width>
      <wheel_base>0.65</wheel_base>
      <wheel_separation>0.605</wheel_separation>
      <steering_limit>0.575959</steering_limit>
      <wheel_radius>0.165</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <steering_only>true</steering_only>
    </plugin>


    <!-- Ignition Gazebo Joint Control Plugin -->
    <plugin filename="libignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>rear_right_joint</joint_name>
      <joint_name>rear_left_joint</joint_name>
      <sub_topic>wheel_velocity</sub_topic>
    </plugin>


    <!-- Ignition Gazebo Joint Control Plugin -->
    <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3 </dimensions>
      <xyz_offset>-0.424080 -0.000011 -0.085581</xyz_offset> <!-- Offset to the rear axle to track the same pose as VTR-->
    </plugin>

</gazebo>


</robot>
